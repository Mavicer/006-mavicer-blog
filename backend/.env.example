# Backend env — copy to .env and edit.
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
BLOG_SECRET_KEY=dev-secret-change-me-in-production

# The Owner Key registrants must supply to become admin. Set your own secret.
OWNER_KEY=change-me

# SQLite path (default: blog.db in cwd)
# BLOG_DB_PATH=blog.db
