{
  "name": "mavicer-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-static-posts.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-static-posts.mjs",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build",
    "preview": "vite preview",
    "pretest": "node scripts/generate-static-posts.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "node scripts/generate-static-posts.mjs && tsc -b --noEmit && tsc -p tsconfig.api.json",
    "dev:api": "wrangler pages dev dist --port 8788",
    "db:local": "wrangler d1 execute mavicer-blog --local --file=../backend-worker/schema.sql",
    "test:projects-ui": "node scripts/check-projects-ui.mjs"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.12",
    "framer-motion": "^11.3.19",
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.427.0",
    "marked": "^14.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "wrangler": "^4.151.0"
  }
}
